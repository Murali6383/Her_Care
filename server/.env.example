PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hercare
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# AI (server-side only, never put this in the client). Without a key, AI chat shows a clear "not configured" state.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_SYSTEM_PROMPT=You are the Her Care assistant. Give supportive, general information. You are not a doctor and must not diagnose; suggest seeing a professional for medical concerns.
